--cpu Cortex-M3
"ble 2\startup_stm32f103xb.o"
"ble 2\main.o"
"ble 2\gpio.o"
"ble 2\dma.o"
"ble 2\usart.o"
"ble 2\stm32f1xx_it.o"
"ble 2\stm32f1xx_hal_msp.o"
"ble 2\stm32f1xx_hal_gpio_ex.o"
"ble 2\stm32f1xx_hal_tim.o"
"ble 2\stm32f1xx_hal_tim_ex.o"
"ble 2\stm32f1xx_hal_uart.o"
"ble 2\stm32f1xx_hal.o"
"ble 2\stm32f1xx_hal_rcc.o"
"ble 2\stm32f1xx_hal_rcc_ex.o"
"ble 2\stm32f1xx_hal_gpio.o"
"ble 2\stm32f1xx_hal_dma.o"
"ble 2\stm32f1xx_hal_cortex.o"
"ble 2\stm32f1xx_hal_pwr.o"
"ble 2\stm32f1xx_hal_flash.o"
"ble 2\stm32f1xx_hal_flash_ex.o"
"ble 2\stm32f1xx_hal_exti.o"
"ble 2\system_stm32f1xx.o"
--strict --scatter "ble 2\ble 2.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "ble 2.map" -o "ble 2\ble 2.axf"