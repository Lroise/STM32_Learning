--cpu Cortex-M3
"led 3\startup_stm32f103xb.o"
"led 3\main.o"
"led 3\gpio.o"
"led 3\stm32f1xx_it.o"
"led 3\stm32f1xx_hal_msp.o"
"led 3\stm32f1xx_hal_gpio_ex.o"
"led 3\stm32f1xx_hal_tim.o"
"led 3\stm32f1xx_hal_tim_ex.o"
"led 3\stm32f1xx_hal.o"
"led 3\stm32f1xx_hal_rcc.o"
"led 3\stm32f1xx_hal_rcc_ex.o"
"led 3\stm32f1xx_hal_gpio.o"
"led 3\stm32f1xx_hal_dma.o"
"led 3\stm32f1xx_hal_cortex.o"
"led 3\stm32f1xx_hal_pwr.o"
"led 3\stm32f1xx_hal_flash.o"
"led 3\stm32f1xx_hal_flash_ex.o"
"led 3\stm32f1xx_hal_exti.o"
"led 3\system_stm32f1xx.o"
--strict --scatter "LED 3\LED 3.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "LED 3.map" -o "LED 3\LED 3.axf"