--cpu Cortex-M3
"breathinglight dsq\startup_stm32f103xb.o"
"breathinglight dsq\main.o"
"breathinglight dsq\gpio.o"
"breathinglight dsq\tim.o"
"breathinglight dsq\stm32f1xx_it.o"
"breathinglight dsq\stm32f1xx_hal_msp.o"
"breathinglight dsq\stm32f1xx_hal_gpio_ex.o"
"breathinglight dsq\stm32f1xx_hal_tim.o"
"breathinglight dsq\stm32f1xx_hal_tim_ex.o"
"breathinglight dsq\stm32f1xx_hal.o"
"breathinglight dsq\stm32f1xx_hal_rcc.o"
"breathinglight dsq\stm32f1xx_hal_rcc_ex.o"
"breathinglight dsq\stm32f1xx_hal_gpio.o"
"breathinglight dsq\stm32f1xx_hal_dma.o"
"breathinglight dsq\stm32f1xx_hal_cortex.o"
"breathinglight dsq\stm32f1xx_hal_pwr.o"
"breathinglight dsq\stm32f1xx_hal_flash.o"
"breathinglight dsq\stm32f1xx_hal_flash_ex.o"
"breathinglight dsq\stm32f1xx_hal_exti.o"
"breathinglight dsq\system_stm32f1xx.o"
--strict --scatter "BreathingLight dsq\BreathingLight dsq.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "BreathingLight dsq.map" -o "BreathingLight dsq\BreathingLight dsq.axf"